FROM php:8.4-fpm

COPY --from=mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/bin/install-php-extensions
RUN install-php-extensions pdo_mysql mysqli mbstring exif pcntl bcmath gd zip intl opcache redis xml curl fileinfo dom tokenizer sodium

RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx supervisor gettext-base git unzip cron \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_MEMORY_LIMIT=-1
ENV COMPOSER_ALLOW_SUPERUSER=1
# NOTE: CACHE_DRIVER / SESSION_DRIVER / QUEUE_CONNECTION yahan SET nahi karte —
# entrypoint.sh boot pe Redis detect karke drivers choose karta hai
# (redis available -> redis, warna file + database queue fallback).
# Pehle yahan "file/file/sync" tha jo .env ko override kar raha tha aur
# har queued job HTTP request ke andar chal raha tha (slow API).

WORKDIR /var/www/html

COPY backend/ .

RUN composer install --no-dev --no-interaction --optimize-autoloader --prefer-dist \
    && chown -R www-data:www-data storage bootstrap/cache

COPY backend/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY backend/docker/supervisord.conf /etc/supervisord.conf
COPY backend/docker/entrypoint.sh /entrypoint.sh
COPY backend/docker/uploads.ini /usr/local/etc/php/conf.d/uploads.ini
COPY backend/php-opcache.ini /usr/local/etc/php/conf.d/opcache-tuning.ini
COPY backend/php.ini /usr/local/etc/php/conf.d/app-php.ini
# PHP-FPM pool: default 5 children bahut kam hai -> 100 (high traffic)
COPY backend/php-fpm-pool.conf /usr/local/etc/php-fpm.d/www.conf
RUN chmod +x /entrypoint.sh

EXPOSE 9000
EXPOSE 10000

ENTRYPOINT ["/entrypoint.sh"]
